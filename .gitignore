# ---------- Dependencies ----------
node_modules/

# ---------- Environment / secrets ----------
# Ignore every .env variant (in any folder)...
.env
.env.*
# ...but allow the committed templates.
!.env.example

# ---------- Build output ----------
dist/
build/
*.tsbuildinfo
.vite/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*

# ---------- Test coverage ----------
coverage/

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.swp
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db
.directory

# ---------- Editor ----------
# Keep shared VS Code settings committable if we add them later; ignore personal ones.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
